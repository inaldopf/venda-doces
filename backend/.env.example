# Copie para .env e preencha. NUNCA commite o .env.
# Banco local (docker compose). Em produção (Aiven) use a URI do serviço com ?sslmode=require
DATABASE_URL=postgresql+psycopg://venda:venda_dev@localhost:5432/venda_doces
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-valor
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Origens permitidas no CORS, separadas por vírgula (ex.: URL do Vercel)
CORS_ORIGINS=http://localhost:8081
ENVIRONMENT=development
